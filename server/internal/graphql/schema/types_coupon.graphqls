# ──────────────────────────────────────────────────
# Coupon types
# ──────────────────────────────────────────────────

type Coupon {
  id: ID!
  code: String!
  name: String!
  type: String!
  discountValue: Money!
  minAmount: Money!
  maxUses: Int!
  useCount: Int!
  maxUsesPerUser: Int!
  isActive: Boolean!
  expiresAt: DateTime
  createdAt: DateTime!
}

input CouponInput {
  code: String!
  name: String!
  type: String!
  discountValue: Money!
  minAmount: Money
  maxUses: Int
  maxUsesPerUser: Int
  isActive: Boolean
  expiresAt: DateTime
}
