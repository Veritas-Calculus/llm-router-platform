{
  "name": "llm-router-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:gql": "node scripts/validate-graphql-operations.mjs",
    "validate:i18n": "node scripts/validate-i18n-keys.mjs",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "build": "npm run validate:gql && npm run validate:i18n && npm run codegen && tsc && vite build",
    "type-check": "npm run codegen && tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@apollo/client": "^4.3.8",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@sentry/react": "^11.16.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "flatted": "^3.4.4",
    "framer-motion": "^14.14.0",
    "graphql": "^17.1.0",
    "i18next": "^27.2.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^18.0.3",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@graphql-codegen/import-types-preset": "^5.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "jsdom": "^31.0.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
