# Single source of truth for local and Docker Compose configuration.
# Copy this file to .env at the repository root and edit secrets before use.

# Server
SERVER_PORT=8080
GIN_MODE=release
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=600
CORS_ORIGINS=http://localhost,http://localhost:3000
FRONTEND_URL=http://localhost
PUBLIC_BACKEND_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=devpassword
DB_NAME=llm_router
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=60

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpassword
REDIS_DB=0
REDIS_TLS_ENABLED=false

# Security and encryption
ENCRYPTION_KEY=dev-32-byte-encryption-key-here!
JWT_SECRET=dev-jwt-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=168h
ADMIN_IP_WHITELIST=

# Default admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=DevAdmin123!
ADMIN_NAME=Administrator

# Registration
# REGISTRATION_MODE moved to DB (Admin → Settings → Security). Default: open.
INVITE_CODE=

# Email
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=LLM Router
EMAIL_SMTP_TLS=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_RPM=60

# Health checks and alerts
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRY_COUNT=3
HEALTH_CHECK_FAILURE_THRESHOLD=3
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Logging and observability
LOG_LEVEL=info
LOG_FORMAT=json
LOKI_URL=http://loki:3100
LOKI_QUERY_SELECTOR={container="llm-router-server"}
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_HOST=http://langfuse-server:3000
SENTRY_ENABLED=false
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0
VITE_SENTRY_DSN=

# Docker Compose monitoring profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123456

# Docker Compose Langfuse profile
LANGFUSE_DB_PASSWORD=devpassword
LANGFUSE_CLICKHOUSE_PASSWORD=devpassword
LANGFUSE_REDIS_AUTH=devpassword
LANGFUSE_MINIO_PASSWORD=devpassword
LANGFUSE_NEXTAUTH_SECRET=dev-nextauth-secret-at-least-32-characters
LANGFUSE_SALT=dev-langfuse-salt-at-least-32-characters
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Data retention / cleanup
CLEANUP_HEALTH_RETENTION_DAYS=30
CLEANUP_ALERT_RETENTION_DAYS=90
CLEANUP_AUDIT_RETENTION_DAYS=90

# Payments: Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Payments: WeChat Pay
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PLATFORM_CERT=

# Payments: Alipay
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=

# CAPTCHA
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OAuth2 / SSO
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=

# Vault (optional)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=llm-router

# Proxy pool
PROXY_POOL_ENABLED=false
PROXY_POOL_URL=
